VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: USDA FoodData Central API key (https://fdc.nal.usda.gov/api-key-signup)
# Without this, DEMO_KEY is used — limited to 1000 req/hour/IP across all users
VITE_USDA_API_KEY=DEMO_KEY

# Sentry error tracking (https://sentry.io — create a React project, copy the DSN)
VITE_SENTRY_DSN=
